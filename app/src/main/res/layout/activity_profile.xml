<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/spidey_dark_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingVertical="32dp">

        <!-- Top Navigation Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_logout"
                android:rotation="180"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/text_white"
                android:contentDescription="Atrás" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Perfil de Usuario Spider-IoT"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_white"
                android:layout_marginStart="12dp" />

        </LinearLayout>

        <!-- Spider Avatar Header -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center_horizontal"
            app:cardCornerRadius="50dp"
            app:cardElevation="6dp"
            app:strokeWidth="3dp"
            app:strokeColor="@color/spidey_gold"
            app:cardBackgroundColor="@color/spidey_red"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="20dp"
                android:src="@drawable/ic_spider_mask"
                app:tint="@color/white"
                android:contentDescription="Spider Avatar" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvUserEmailTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="usuario@spidey.com"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/spidey_gold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="🕷️ Agente Monitoreo IoT"
            android:textSize="13sp"
            android:textColor="@color/text_muted"
            android:layout_marginBottom="28dp" />

        <!-- User Information Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/spidey_web_line"
            app:cardBackgroundColor="@color/spidey_card_bg"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Detalles de la Cuenta"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/spidey_gold"
                    android:layout_marginBottom="16dp" />

                <!-- Email Detail -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Correo Registrado:"
                    android:textSize="12sp"
                    android:textColor="@color/text_muted" />

                <TextView
                    android:id="@+id/tvUserEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--@--"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_white"
                    android:layout_marginBottom="16dp" />

                <!-- UID Detail -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ID de Usuario Firebase (UID):"
                    android:textSize="12sp"
                    android:textColor="@color/text_muted" />

                <TextView
                    android:id="@+id/tvUserUid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UID: --"
                    android:textSize="13sp"
                    android:textColor="@color/text_white"
                    android:layout_marginBottom="16dp" />

                <!-- Connection Status -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estado de Red:"
                    android:textSize="12sp"
                    android:textColor="@color/text_muted" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟢 Sincronizado en Tiempo Real"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/pump_green" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Actions -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReturnDashboard"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Volver al Dashboard"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            android:backgroundTint="@color/spidey_blue"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogoutProfile"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Cerrar Sesión"
            android:textSize="16sp"
            android:textColor="@color/error_red"
            app:strokeColor="@color/error_red"
            app:icon="@drawable/ic_logout"
            app:iconTint="@color/error_red"
            app:cornerRadius="14dp" />

    </LinearLayout>

</ScrollView>
